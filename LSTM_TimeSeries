    "look_back = 3\n",
    "\n",
    "# Create dataset\n",
    "trainX, trainY = create_dataset(train, look_back)\n",
    "testX, testY = create_dataset(test, look_back)\n",
    "\n",
    "# Reshape input to [samples, timesteps, features]\n",
    "trainX = np.reshape(trainX, (trainX.shape[0], look_back, 1))\n",
    "testX = np.reshape(testX, (testX.shape[0], look_back, 1))\n",
    "\n",
    "batch_size = 1\n",
    "\n",
    "# -------------------------------\n",
    "# 🚀 Define Stacked Stateful LSTM\n",
    "# -------------------------------\n",
    "model = Sequential([\n",
    "    LSTM(50, stateful=True, return_sequences=True),\n",
    "    LSTM(50, stateful=True, return_sequences=False),\n",
    "    Dense(1)\n",
    "])\n",
    "\n",
    "# Build model explicitly for fixed batch size\n",
    "model.build(input_shape=(batch_size, look_back, 1))\n",
    "\n",
    "model.compile(loss='mean_squared_error', optimizer='adam')\n",
    "\n",
    "# -------------------------------\n",
    "# 🧠 Train Model Epoch-by-Epoch\n",
    "# -------------------------------\n",
    "for i in range(100):\n",
    "    print(f\"Epoch {i+1}/100\")\n",
    "    model.fit(trainX, trainY, epochs=1, batch_size=batch_size, verbose=2, shuffle=False)\n",
    "    # Reset states for all stateful LSTM layers\n",
    "    for layer in model.layers:\n",
    "        if hasattr(layer, 'reset_states'):\n",
    "            layer.reset_states()\n",
    "\n",
    "# -------------------------------\n",
    "# 📈 Make Predictions\n",
    "# -------------------------------\n",
    "trainPredict = model.predict(trainX, batch_size=batch_size)\n",
    "testPredict = model.predict(testX, batch_size=batch_size)\n",
    "\n",
    "# Invert scaling for plotting\n",
    "trainPredict = scaler.inverse_transform(trainPredict)\n",
    "trainY_inv = scaler.inverse_transform(trainY.reshape(-1, 1))\n",
    "testPredict = scaler.inverse_transform(testPredict)\n",
    "testY_inv = scaler.inverse_transform(testY.reshape(-1, 1))\n",
    "\n",
    "# Shift train predictions for plotting\n",
    "trainPredictPlot = np.empty_like(dataset)\n",
    "trainPredictPlot[:, :] = np.nan\n",
    "trainPredictPlot[look_back:len(trainPredict)+look_back, :] = trainPredict\n",
    "\n",
    "# Shift test predictions for plotting (fixed)\n",
    "testPredictPlot = np.empty_like(dataset)\n",
    "testPredictPlot[:, :] = np.nan\n",
    "test_start = len(trainPredict) + (look_back * 2)\n",
    "testPredictPlot[test_start:test_start + len(testPredict), :] = testPredict\n",
    "\n",
    "# Plot baseline and predictions\n",
    "plt.figure(figsize=(10,6))\n",
    "plt.plot(scaler.inverse_transform(dataset), label='Actual Data')\n",
    "plt.plot(trainPredictPlot, label='Train Prediction')\n",
    "plt.plot(testPredictPlot, label='Test Prediction')\n",
    "plt.legend()\n",
    "plt.title('LSTM Time Series Prediction - International Airline Passengers')\n",
    "plt.show()"
   ]
