    "# LSTM (regression) for International Airline Passengers (complete)\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import math\n",
    "import tensorflow as tf\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import Dense, LSTM\n",
    "from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "from sklearn.metrics import mean_squared_error\n",
    "import os\n",
    "from datetime import datetime\n",
    "# ---- reproducibility ----\n",
    "np.random.seed(7)\n",
    "tf.random.set_seed(7)\n",
    "\n",
    "# ---- user variables ----\n",
    "DATA_PATH = \"/kaggle/input/airline-pax/airline-pax.csv\"  # update if needed\n",
    "LOOK_BACK = 12                  # use 12 months (seasonal)\n",
    "EPOCHS = 200\n",
    "BATCH_SIZE = 16\n",
    "FORECAST_STEPS = 12             # months to forecast after available data\n",
    "\n",
    "# ---- helper: create dataset windows ----\n",
    "def create_dataset(dataset, look_back=1):\n",
    "    \"\"\"\n",
    "    dataset: 2D numpy array (n, 1)\n",
    "    returns: X (n_samples, look_back), y (n_samples,)\n",
    "    \"\"\"\n",
    "    dataX, dataY = [], []\n",
    "    for i in range(len(dataset) - look_back):\n",
    "        a = dataset[i:(i + look_back), 0]\n",
    "        dataX.append(a)\n",
    "        dataY.append(dataset[i + look_back, 0])\n",
    "    return np.array(dataX), np.array(dataY)\n",
    "\n",
    "# ---- load data ----\n",
    "df = pd.read_csv(DATA_PATH, usecols=[1], header=0)  # expects csv with second column=Passengers\n",
    "# if the file has header \"Passengers\" it's fine\n",
    "values = df.values.astype('float32')\n",
    "\n",
    "# ---- split train/test (time series split) ----\n",
    "train_size = int(len(values) * 0.67)\n",
    "train_values = values[:train_size]\n",
    "test_values = values[train_size:]\n",
    "\n",
    "# ---- scale using train scaler only (avoid leakage) ----\n",
    "scaler = MinMaxScaler(feature_range=(0, 1))\n",
    "scaler = scaler.fit(train_values)   # fit on train only\n",
    "\n",
    "train_scaled = scaler.transform(train_values)\n",
    "test_scaled = scaler.transform(test_values)\n",
    "\n",
    "# ---- make windows ----\n",
    "look_back = LOOK_BACK\n",
    "trainX, trainY = create_dataset(train_scaled, look_back)\n",
    "testX, testY = create_dataset(test_scaled, look_back)\n",
    "\n",
    "# ---- reshape to [samples, time_steps, features] ----\n",
    "trainX = trainX.reshape((trainX.shape[0], look_back, 1))\n",
    "testX  = testX.reshape((testX.shape[0],  look_back, 1))\n",
    "\n",
    "# ---- build model ----\n",
    "model = Sequential([\n",
    "    LSTM(64, return_sequences=True, input_shape=(look_back, 1)),\n",
    "    LSTM(32),\n",
    "    Dense(1)\n",
    "])\n",
    "model.compile(loss='mean_squared_error', optimizer='adam')\n",
    "model.summary()\n",
    "\n",
    "# ---- callbacks ----\n",
    "os.makedirs(\"model_checkpoints\", exist_ok=True)\n",
    "chk_path = \"model_checkpoints/best_lstm.h5\"\n",
    "es = EarlyStopping(monitor='val_loss', patience=20, restore_best_weights=True, verbose=1)\n",
    "mc = ModelCheckpoint(chk_path, monitor='val_loss', save_best_only=True, verbose=1)\n",
    "\n",
    "# ---- train ----\n",
    "history = model.fit(\n",
    "    trainX, trainY,\n",
    "    validation_data=(testX, testY),\n",
    "    epochs=EPOCHS,\n",
    "    batch_size=BATCH_SIZE,\n",
    "    callbacks=[es, mc],\n",
    "    verbose=2\n",
    ")\n",
    "\n",
    "# ---- predictions ----\n",
    "trainPredict = model.predict(trainX)\n",
    "testPredict  = model.predict(testX)\n",
    "\n",
    "# ---- invert scaling (remember scaler was fit on 1D values) ----\n",
    "# scaler expects shape (n_samples, n_features)\n",
    "trainPredict_inv = scaler.inverse_transform(trainPredict)\n",
    "trainY_inv = scaler.inverse_transform(trainY.reshape(-1, 1))\n",
    "testPredict_inv = scaler.inverse_transform(testPredict)\n",
    "testY_inv = scaler.inverse_transform(testY.reshape(-1, 1))\n",
    "\n",
    "# ---- compute RMSE ----\n",
    "trainScore = math.sqrt(mean_squared_error(trainY_inv[:,0], trainPredict_inv[:,0]))\n",
    "testScore  = math.sqrt(mean_squared_error(testY_inv[:,0],  testPredict_inv[:,0]))\n",
    "print(f\"Train Score: {trainScore:.2f} RMSE\")\n",
    "print(f\"Test  Score: {testScore:.2f} RMSE\")\n",
    "\n",
    "# ---- prepare full-series arrays for plotting predictions aligned with original series ----\n",
    "# combine train + test (original) for plotting\n",
    "full_scaled = np.vstack((train_scaled, test_scaled))\n",
    "full_inversed = scaler.inverse_transform(full_scaled)  # full series but scaled with train scaler\n",
    "\n",
    "# create arrays filled with nan for plotting\n",
    "trainPredictPlot = np.full((len(full_scaled), 1), np.nan, dtype=float)\n",
    "testPredictPlot  = np.full((len(full_scaled), 1), np.nan, dtype=float)\n",
    "\n",
    "# fill train predictions (start at index = look_back)\n",
    "train_start = look_back\n",
    "trainPredictPlot[train_start:train_start + len(trainPredict_inv), 0] = trainPredict_inv[:,0]\n",
    "\n",
    "# fill test predictions: test starts at index train_size; predictions start at train_size + look_back\n",
    "test_start = train_size + look_back\n",
    "testPredictPlot[test_start:test_start + len(testPredict_inv), 0] = testPredict_inv[:,0]\n",
    "\n",
    "# ---- plot actual vs predicted ----\n",
    "plt.figure(figsize=(12,6))\n",
    "plt.plot(full_inversed, label='Actual (inversed)', linewidth=1)\n",
    "plt.plot(trainPredictPlot, label='Train Predict', linewidth=1)\n",
    "plt.plot(testPredictPlot, label='Test Predict', linewidth=1)\n",
    "plt.title('LSTM: Airline Passengers - Actual vs Predicted')\n",
    "plt.xlabel('Time (months index)')\n",
    "plt.ylabel('Passengers')\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()\n",
    "\n",
    "# ---- recursive multi-step forecast for next FORECAST_STEPS months ----\n",
    "# take last available look_back scaled values from the entire dataset\n",
    "last_sequence = np.vstack((train_scaled, test_scaled))[-look_back:]   # shape (look_back, 1)\n",
    "forecast_scaled = []\n",
    "current_sequence = last_sequence.copy()  # (look_back, 1)\n",
    "\n",
    "for step in range(FORECAST_STEPS):\n",
    "    # reshape to (1, look_back, 1)\n",
    "    x_input = current_sequence.reshape((1, look_back, 1))\n",
    "    yhat_scaled = model.predict(x_input)\n",
    "    # append prediction\n",
    "    forecast_scaled.append(yhat_scaled[0,0])\n",
    "    # roll sequence and append predicted value\n",
    "    current_sequence = np.roll(current_sequence, -1, axis=0)\n",
    "    current_sequence[-1, 0] = yhat_scaled[0,0]\n",
    "\n",
    "# invert forecast\n",
    "forecast_scaled_arr = np.array(forecast_scaled).reshape(-1,1)\n",
    "forecast_inv = scaler.inverse_transform(forecast_scaled_arr)\n",
    "\n",
    "# show forecasted numbers\n",
    "forecast_months = [f\"t+{i+1}\" for i in range(FORECAST_STEPS)]\n",
    "forecast_df = pd.DataFrame({'step': forecast_months, 'forecast_passengers': forecast_inv.flatten()})\n",
    "print(\"\\nNext\", FORECAST_STEPS, \"months (recursive forecast):\")\n",
    "print(forecast_df)\n",
    "\n",
    "# ---- plot recent history + forecast ----\n",
    "plt.figure(figsize=(12,6))\n",
    "# plot last 3 years of actuals for context\n",
    "n_history = 36\n",
    "recent_actual = full_inversed[-n_history:].flatten()\n",
    "plt.plot(range(len(recent_actual)), recent_actual, label='Recent Actuals')\n",
    "# plot forecast appended after recent_actual\n",
    "forecast_x = np.arange(len(recent_actual), len(recent_actual) + len(forecast_inv))\n",
    "plt.plot(forecast_x, forecast_inv.flatten(), marker='o', linestyle='--', label='Forecast Next 12')\n",
    "plt.title('Recent Actuals and 12-step Forecast')\n",
    "plt.xlabel('Time index (relative)')\n",
    "plt.ylabel('Passengers')\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
